{
  "mqtt_broker": "localhost",
  "mqtt_port": 1883,
  "matter_server": "ws://localhost:5580/ws",
  "log_level": "DEBUG",
  "log_file": "/tmp/bridge.log",
  "devices": [
    {
      "name": "ESP32 Living Room Light",
      "type": "onoff_light",
      "node_id": 8,
      "endpoint_id": 1,
      "mqtt_topic": "home/living/light",
      "mqtt_command_topic": "home/living/light/set",
      "mqtt_field": "onoff",
      "matter_cluster": "onoff",
      "matter_attribute": "OnOff",
      "transform": "none"
    },
    {
      "name": "Humidity Sensor",
      "node_id": 8,
      "endpoint_id": 2,
      "mqtt_topic": "home/sensor/humidity",
      "mqtt_field": "humidity",
      "matter_cluster": "relativehumiditymeasurement",
      "matter_attribute": "MeasuredValue",
      "transform": "multiply_100"
    }
  ]
}